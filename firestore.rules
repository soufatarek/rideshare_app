rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =============================================
    // USERS — only the owner can read/write
    // =============================================
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Subcollections (saved_places, etc.)
      match /{subcollection=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // =============================================
    // DRIVERS — only the owner can read/write
    // =============================================
    match /drivers/{driverId} {
      allow read, write: if request.auth != null && request.auth.uid == driverId;

      // Subcollections
      match /{subcollection=**} {
        allow read, write: if request.auth != null && request.auth.uid == driverId;
      }
    }

    // =============================================
    // DRIVER STATUS — driver writes, all authed read
    // =============================================
    match /driver_status/{driverId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == driverId;
    }

    // =============================================
    // RIDE REQUESTS
    // =============================================
    match /ride_requests/{requestId} {
      allow create: if request.auth != null
        && request.resource.data.riderId == request.auth.uid;

      allow read: if request.auth != null
        && (resource.data.riderId == request.auth.uid
            || resource.data.get('driverId', '') == request.auth.uid
            || resource.data.status == 'searching');

      allow update: if request.auth != null
        && (
          // The rider who created it can update (cancel, rate)
          resource.data.riderId == request.auth.uid

          // The assigned driver can update (status, location)
          || resource.data.get('driverId', '') == request.auth.uid

          // Any authed user can accept a searching ride (sets driverId)
          || (
            resource.data.status == 'searching'
            && request.resource.data.get('driverId', '') == request.auth.uid
          )

          // Any authed driver can add themselves to declinedBy
          || (
            resource.data.status == 'searching'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['declinedBy'])
          )
        )
        // Prevent clients from tampering with price fields
        && (!request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['serverPrice', 'baseFare', 'surgeMultiplier']));

      allow delete: if false;
    }

    // =============================================
    // TRIPS — read only (created by Cloud Function)
    // =============================================
    match /trips/{tripId} {
      allow read: if request.auth != null
        && (resource.data.userId == request.auth.uid
            || resource.data.driverId == request.auth.uid);
      allow write: if false;
    }

    // =============================================
    // PHONE INDEX — service lookups
    // =============================================
    match /phone_index/{phone} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /driver_phone_index/{phone} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
